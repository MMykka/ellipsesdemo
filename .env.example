# Local CORS proxy to the online US Census geocoder (scripts/geocode/server.mjs). See docs/OFFLINE_SETUP.md.
VITE_GEOCODE_URL=http://localhost:5175

# Regional PMTiles map archive. Defaults to /tiles/region.pmtiles served from public/tiles/ —
# put your built .pmtiles file there under that name, or point this at a different URL/path.
# See docs/OFFLINE_SETUP.md.
VITE_PMTILES_URL=/tiles/region.pmtiles
